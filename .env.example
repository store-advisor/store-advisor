# Copy this file to .env at the repo root. Docker Compose reads .env
# automatically for ${VAR} substitution in docker-compose.yml.
# This is separate from backend/.env, which is read directly by Prisma
# CLI and NestJS when running locally (outside Docker) via
# `npm run start:dev`.

POSTGRES_USER=storeadvisor
POSTGRES_PASSWORD=localdev
POSTGRES_DB=storeadvisor
DATABASE_URL=postgresql://storeadvisor:localdev@postgres:5432/storeadvisor
# The AI service (stage 3). Without it the service still boots and answers
# 503 on /api/explain; findings are detected and served, just without prose.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# The worker (src/scheduler). Hourly, on the hour, is the production cadence.
# Set this to '*/1 * * * *' when demonstrating, so a schedule fires while
# someone is watching rather than up to an hour later.
CHECK_SCHEDULE_CRON=0 * * * *
# How many merchants the worker checks at once.
CHECK_CONCURRENCY=5
# Set to 'false' to run a worker that consumes jobs but registers no
# schedule. Only useful when running several workers behind one schedule.
SCHEDULER_ENABLED=true

# The dashboard. These are compiled into the browser bundle at image build
# time, so they name addresses the browser can reach, not container names.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AI_URL=http://localhost:8000
WEB_PORT=3001
